pipeline {
    agent any

    stages {

        stage('Test Docker') {
            steps {
                sh 'docker --version'
                sh 'docker ps'
                sh 'docker-compose version'
            }
        }

        stage('Build Application') {
            steps {
                dir('akash-hotels') {
                    sh 'chmod +x mvnw'
                    sh './mvnw clean package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('akash-hotels') {
                    sh 'docker build -t akash-hotels:jenkins .'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('akash-hotels') {
                    sh '''
                        docker-compose down
                        docker-compose up -d --build
                    '''
                }
            }
        }
    }
}