pipeline {
    agent any

    stages {

        stage('Test Docker') {
            steps {
                sh 'docker --version'
                sh 'docker ps'
            }
        }

        stage('Build Application') {
            steps {
                dir('akash-hotels') {
                    sh 'chmod +x mvnw'
                    sh './mvnw clean package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('akash-hotels') {
                    sh 'docker build -t akazz0/akash-hotels:latest .'
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
                        docker push akazz0/akash-hotels:latest
                        docker logout
                    '''
                }
            }
        }
        stage('Deploy') {
    steps {
        dir('akash-hotels') {
            sh '''
                docker compose pull
                docker compose up -d
            '''
        }
    }
}

    }
}